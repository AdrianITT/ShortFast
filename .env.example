# Copia este archivo a .env (cp .env.example .env) y ajusta lo que necesites.
# Lo leen docker compose y el panel (python3 -m panel). Todo es opcional salvo, si usas IA, la clave de Gemini.

# ── Datos ──
# Carpeta del equipo con proyectos/, salida/ y plantilla/ (se crean solas, excepto el contenido de plantilla/).
DATA_DIR=./datos

# ── Puertos del equipo ──
API_PORT=8123
KOKORO_PORT=8880

# ── Permisos de archivos (en Linux: salida de `id -u` y `id -g`) ──
PUID=1000
PGID=1000

# ── IA para generar guías (opcional) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Comandos de shell (nuevo-short, render-short, guia-short) ──
# Vacío = usan el servicio de docker compose. Si tu API corre como un contenedor suelto, pon su nombre.
# API_CONTENEDOR=ffmpeg-api

# ── Panel de terminal (opcionales: por defecto se deducen de lo anterior) ──
# FFMPEG_API_URL=http://localhost:8123     # otra API, p. ej. en un servidor
# TTS_URL=http://localhost:8880            # otro servicio de voz
TTS_VOZ=em_alex
# PROYECTOS_DIR=./datos/proyectos          # carpeta de proyectos que ve el panel
# DESCARGAS_DIR=~/Videos/ffmpeg-api        # dónde guarda los videos descargados
