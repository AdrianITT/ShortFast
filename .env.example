# Configuración de ShortFast. ./instalar.sh crea .env a partir de este archivo y rellena lo necesario.
# Lo leen docker compose y el panel. Todo es opcional salvo, si usas IA, la clave de Gemini.

# ── Qué voces se instalan (perfiles de docker compose, separados por comas) ──
# supertonic = voz local recomendada · clonador = «Mis voces» (necesita supertonic, imagen de ~3 GB)
# kokoro = voz local con más voces en inglés · edge = voces de Microsoft (requiere internet)
COMPOSE_PROFILES=supertonic,clonador

# ── Datos ──
# Carpeta del equipo con proyectos/, salida/, voces_propias/… (se crean solas, excepto el contenido de plantilla/).
DATA_DIR=./datos

# ── Puertos del equipo ──
API_PORT=8123
PANEL_PORT=8090
# Las voces solo se publican en este equipo (127.0.0.1); pon 0.0.0.0 para usarlas desde la red (p. ej. n8n).
VOCES_IP=127.0.0.1
SUPERTONIC_PORT=5200
CLONADOR_PORT=5300
KOKORO_PORT=8880
EDGE_TTS_PORT=5050

# ── Permisos de archivos (en Linux: salida de `id -u` y `id -g`) ──
PUID=1000
PGID=1000

# ── Claves ──
# Clave común de los servicios de voz (la genera el instalador). Vacía = sin clave (solo red de confianza).
TTS_API_KEY=
# Contraseña del panel web (opcional; vacío = sin contraseña). El navegador pide usuario (cualquiera) y esta contraseña.
PANEL_CLAVE=

# ── Voz por defecto del panel ──
PANEL_TTS_URL=http://supertonic:5000
PANEL_TTS_VOZ=M3
SUPERTONIC_VOZ=M3
# SUPERTONIC_PASOS=8                       # 5 = más rápido, 12 = más calidad
# TTS_VELOCIDAD=1.0                        # 0.9-0.95 suena más pausado
# EDGE_TTS_VOZ=es-MX-DaliaNeural
# CLONADOR_TAU=0.3                         # más bajo = más parecido a la grabación, más alto = más natural

# ── IA para generar guías (opcional) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Solo si usas el panel de terminal o los comandos fuera de Docker (python3 -m panel en el equipo) ──
# API_CONTENEDOR=ffmpeg-api                # comandos de shell: nombre del contenedor de la API
# FFMPEG_API_URL=http://localhost:8123
# TTS_URL=http://localhost:5200            # servicio de voz por defecto de la terminal
# TTS_VOZ=M3
# SUPERTONIC_URL=http://localhost:5200
# CLONADOR_URL=http://localhost:5300
# KOKORO_URL=http://localhost:8880
# EDGE_TTS_URL=http://localhost:5050
# PROYECTOS_DIR=./datos/proyectos
# DESCARGAS_DIR=~/Videos/ffmpeg-api
